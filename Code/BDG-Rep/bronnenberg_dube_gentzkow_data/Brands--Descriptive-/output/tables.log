. *****************************************************************
. * TABLE (Extra regression table for slides)
. *****************************************************************
. cap program drop addtotable

. program addtotable
  1.         local r2 = e(r2)
  2.         local N = e(N)
  3.         local mod = e(N_clust)
  4.         nlcom (cons: _b[_cons]) (coeff: _b[decades]) (years: 10*(1-_b[_cons])/_b[decades]), post
  5.         matrix TABLE = (nullmat(TABLE) , (_b[cons] \ _se[cons] \ _b[coeff] \ _se[coeff] \ . \ . \ _b[years] \ _se[years] \ `r2' \ `mod' \ `N'))
  6. end

