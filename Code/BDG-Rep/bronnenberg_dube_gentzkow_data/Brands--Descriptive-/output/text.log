. cap program drop addtotable_bp

. program addtotable_bp
  1.         local r2 = e(r2)
  2.         local N = e(N)
  3.         local prs = e(N_clust)
  4.         nlcom (par1: _b[years_treated]) (par2: _b[treat_in_b]) (par3: _b[years_untreated]) (par4: _b[not_treat_in_b]), post
  5.         matrix TABLE = (nullmat(TABLE) , (_b[par1] \ _se[par1] \ _b[par2] \ _se[par2] \ _b[par3] \ _se[par3] \ _b[par4] \ _se[par4] \ `prs' \ `N'))
  6. end

