	author = {Shum, Matthew},
	month = jun,
	year = {2004},
	pages = {241--272},
	file = {PDF:files/125/Shum - 2004 - Does Advertising Overcome Brand Loyalty Evidence from the Breakfast‐Cereals Market.pdf:application/pdf},
}

