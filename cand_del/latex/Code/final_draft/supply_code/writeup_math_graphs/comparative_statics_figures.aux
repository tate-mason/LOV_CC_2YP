\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces $R_j=p_1^*(j)/p_2^*(j)$ and $R_0=p_1^*(0)/p_2^*(0)$. Each curve holds its stated histories fixed and uses the analytical quotient rule. Benchmark: $\beta =2$, $\alpha =-1$, $\delta =0.92$, $c=0$; $\gamma \in [-3,3]$.}}{6}{figure.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces $R_{0\to j}=p_1^*(0)/p_2^*(j)$, conditional on a first-period acquisition. This is a path-specific comparison, not an ex-ante expectation. Benchmark: $\beta =2$, $\alpha =-1$, $\delta =0.92$, $c=0$; $\gamma \in [-3,3]$.}}{7}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Expected discounted profit includes both realized continuation histories. The two curves condition on the initial realized state. Benchmark: $\beta =2$, $\alpha =-1$, $\delta =0.92$, $c=0$; $\gamma \in [-3,3]$.}}{8}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Total derivatives use the envelope theorem and both continuation-value derivatives. Their signs depend on the initial history and the stated thresholds. Benchmark: $\beta =2$, $\alpha =-1$, $\delta =0.92$, $c=0$; $\gamma \in [-3,3]$.}}{9}{figure.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Left: period-1 prices for both initial states. Right: period-2 prices for both realized first-period states. Prices are unconstrained; all shares adjust. Benchmark: $\beta =2$, $\alpha =-1$, $\delta =0.92$, $c=0$; $\gamma \in [-3,3]$.}}{10}{figure.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Analytical total derivatives, with both continuation branches reoptimized. Initial-state signs are interpreted using the proved conditional statements. Benchmark: $\beta =2$, $\alpha =-1$, $\delta =0.92$, $c=0$; $\gamma \in [-3,3]$.}}{11}{figure.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces All four conditional price ratios under the same benchmark calibration.}}{12}{figure.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Analytical quotient-rule derivatives for each fixed history $(x_0,x_1)$.}}{13}{figure.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Profit for all four histories; terminal demand is integrated out. Benchmark: $\beta =2$, $\alpha =-1$, $\delta =0.92$, $c=0$.}}{14}{figure.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Inside and outside shares in each period for all four histories. Benchmark: $\beta =2$, $\alpha =-1$, $\delta =0.92$, $c=0$.}}{15}{figure.10}\protected@file@percent }
